#!/usr/bin/env bash
# apexyard -- CLI commands and framework skills from the shell.
#
# Install: symlink this script into a directory on your PATH.
#
#   ln -s "$(pwd)/bin/apexyard" ~/.local/bin/apexyard
#
# Usage:
#   apexyard status [-b|--briefing]   # 4-line "where am I" briefing
#   apexyard doctor                 # environment report; optional dependency installs
#   apexyard doctor --drift         # list local edits to framework-owned files
#   apexyard migrate [opts]         # keep CLI or move fork to init layout
#   apexyard --help
#
# The script delegates to .claude/skills/status/briefing.sh inside the
# nearest apexyard fork (it walks up from $PWD looking for a directory
# that contains both onboarding.yaml AND apexyard.projects.yaml). This
# means `apexyard status` works from anywhere inside the fork or any of
# its workspace/<name>/ clones -- the same scope rules as /start-ticket
# and the portfolio-aware skills.

set -u

APEXYARD_CLI_VERSION="__VERSION__"

# ---------------------------------------------------------------------------
# Resolve the ops-fork root from $PWD by walking up. Honours both the
# v2 `.apexyard-fork` marker (split-portfolio v2, framework >= #242) and
# the legacy v1 anchor (onboarding.yaml + apexyard.projects.yaml). Same
# algorithm as the briefing helper itself; we replicate it here so the
# shim stays a single self-contained file.
# ---------------------------------------------------------------------------
find_ops_root() {
  local cur="$PWD"
  while [ -n "$cur" ] && [ "$cur" != "/" ]; do
    # v2 anchor (cheap presence test).
    if [ -e "$cur/.apexyard-fork" ]; then
      printf '%s' "$cur"
      return 0
    fi
    # Legacy v1 anchor.
    if [ -e "$cur/onboarding.yaml" ] && [ -e "$cur/apexyard.projects.yaml" ]; then
      printf '%s' "$cur"
      return 0
    fi
    cur=$(dirname "$cur")
  done
  return 1
}

# Test the same anchors without walking to a parent directory.
is_ops_root() {
  [ -n "$1" ] || return 1
  # The skills folder separates the ops repo from a split-portfolio private repo.
  [ -d "$1/.claude/skills" ] || return 1
  [ -e "$1/.apexyard-fork" ] || {
    [ -e "$1/onboarding.yaml" ] && [ -e "$1/apexyard.projects.yaml" ]
  }
}

ops_root_file() {
  printf '%s/apexyard/ops-root' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

saved_ops_root() {
  local file
  file=$(ops_root_file)
  [ -f "$file" ] || return 1
  cat "$file"
}

save_ops_root() (
  umask 077
  file=$(ops_root_file)
  [ "$(saved_ops_root)" != "$1" ] || exit 0
  mkdir -p "$(dirname "$file")" || exit 1
  tmp=$(mktemp "$file.tmp.XXXXXX") || exit 1
  trap 'rm -f "$tmp"' EXIT
  printf '%s\n' "$1" > "$tmp" && mv -f "$tmp" "$file"
)

# Order: the folder you are in, then APEXYARD_OPS_ROOT, then the saved path.
# Agent sessions export APEXYARD_OPS_ROOT, so it must never beat the folder.
# Pass "skills" when the command runs a skill. A split-portfolio private repo
# has the legacy anchor files but no skills, so it is never saved, and a skill
# command falls through to the other sources from there.
resolve_ops_root_any() {
  local root need=${1:-}
  if root=$(find_ops_root); then
    if [ -d "$root/.claude/skills" ]; then
      [ "${APEXYARD_RESOLVE_READ_ONLY:-0}" = 1 ] || save_ops_root "$root" 2>/dev/null || true
      printf '%s' "$root"
      return 0
    fi
    if [ "$need" != skills ]; then
      printf '%s' "$root"
      return 0
    fi
  fi
  if [ -n "${APEXYARD_OPS_ROOT:-}" ]; then
    if ! is_ops_root "$APEXYARD_OPS_ROOT"; then
      printf 'APEXYARD_OPS_ROOT is not an ApexYard ops repo: %s\n' "$APEXYARD_OPS_ROOT" >&2
      return 2
    fi
    (cd "$APEXYARD_OPS_ROOT" && pwd -P)
    return
  fi
  root=$(saved_ops_root) || return 1
  if is_ops_root "$root"; then
    printf '%s' "$root"
    return 0
  fi
  printf 'apexyard: the saved ops repo %s is gone. Run apexyard use %s.\n' "$root" "$root" >&2
  return 1
}

# Follow each symlink to the real script. Bash 3.2 has no readlink -f.
resolve_cli_path() {
  local path="${BASH_SOURCE[0]}" hops=0 target dir
  while [ -L "$path" ]; do
    hops=$((hops + 1))
    [ "$hops" -le 16 ] || return 1
    target=$(readlink "$path") || return 1
    case "$target" in
      /*) path="$target" ;;
      *)
        dir=$(dirname "$path")
        case "$dir" in
          /*) ;;
          *) dir=$(cd "$dir" && pwd) || return 1 ;;
        esac
        path="$dir/$target"
        ;;
    esac
  done
  dir=$(cd "$(dirname "$path")" && pwd -P) || return 1
  printf '%s' "$dir/$(basename "$path")"
}

# Require the same fork anchors as status, with the skill exit code.
skill_root() {
  resolve_ops_root_any skills || {
    [ "$?" -ne 2 ] || return 2
    echo "apexyard: not inside an apexyard fork (no .apexyard-fork marker, and no onboarding.yaml + apexyard.projects.yaml found above $PWD)" >&2
    return 2
  }
}

# Read only the frontmatter, never matching instructions in the body.
skill_field() {
  awk -v key="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    /^---[[:space:]]*$/ { exit }
    index($0, key ":") == 1 {
      sub(/^[^:]*:[[:space:]]*/, "")
      sub(/[[:space:]\r]+$/, "")
      gsub(/^["\047]|["\047]$/, "")
      print; exit
    }
  ' "$1"
}

launch_skill() {
  local root=$1 skill=$2 prompt agent arg
  shift 2
  prompt="/$skill"
  for arg in "$@"; do prompt="$prompt $arg"; done
  agent=${APEXYARD_AGENT_CMD:-claude}
  if ! command -v "$agent" >/dev/null 2>&1; then
    printf 'Run this in your agent tool, from %s: %s\n' "$root" "$prompt"
    return 0
  fi
  cd "$root" || return 2
  exec "$agent" "$prompt"
}

ticket_skill() {
  local root=$1 target="" repo number parsed clone="" current=$PWD
  local worktree="" line candidate="" title type slug branch="" base helper
  local selector="" dry=0 json=0 agent=claude style arg resolved_repo resolved_clone
  local APEXYARD_DISABLE_RESOLUTION_CACHE=1
  export APEXYARD_DISABLE_RESOLUTION_CACHE
  shift
  while [ "$#" -gt 0 ]; do
    arg=$1; shift
    case "$arg" in
      --repo|--agent)
        [ "$#" -gt 0 ] && [ -n "$1" ] || { echo "$arg requires a value." >&2; return 2; }
        if [ "$arg" = --repo ]; then selector=$1; else agent=$1; fi
        shift ;;
      --dry-run) dry=1 ;;
      --json) json=1 ;;
      -*) echo "Unknown option: $arg" >&2; return 2 ;;
      *) [ -z "$target" ] || { echo 'Specify one ticket.' >&2; return 2; }; target=$arg ;;
    esac
  done
  style=$(repo_agent_style "$agent") || return 2
  if [[ "$target" =~ ^([A-Za-z0-9_.-]+/)?[A-Za-z0-9_.-]+#[0-9]+$ ]]; then
    [ -n "$selector" ] || selector=${target%#*}
    number=${target##*#}
  elif [[ "$target" =~ ^[0-9]+$ ]]; then
    number=$target
  else
    echo 'Usage: apexyard ticket owner/repo#N (or apexyard start <ticket> [--repo <name|owner/name>])' >&2
    return 2
  fi
  repo_resolve "$root" "$selector" "$current" "$json" || return 2
  repo=$resolved_repo; clone=$resolved_clone
  target="$repo#$number"
  [ -d "$clone" ] || {
    printf 'apexyard: no clone of %s at %s. Clone it first:\n' "$repo" "$clone" >&2
    printf 'gh repo clone %s %s\n' "$repo" "$clone" >&2; return 2;
  }
  parsed=$(git -C "$clone" worktree list --porcelain) || return 2
  while IFS= read -r line; do
    case "$line" in
      'worktree '*) candidate=${line#worktree } ;;
      branch\ refs/heads/*/GH-"$number"-*) worktree=$candidate; branch=${line#branch refs/heads/}; break ;;
    esac
  done <<< "$parsed"
  if [ -z "$worktree" ]; then
    title=$("${APEXYARD_GH:-gh}" issue view "$number" --repo "$repo" --json title -q .title) || return 2
    case "$title" in
      '[Feature]'*) type=feature ;; '[Bug]'*) type=fix ;;
      '[Docs]'*) type=docs ;; '[Refactor]'*) type=refactor ;;
      '[CI]'*) type=ci ;; '[Testing]'*) type="test" ;; *) type=chore ;;
    esac
    slug=$(printf '%s' "$title" | sed 's/^\[[^]]*\]//' | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9]/-/g; s/-\{1,\}/-/g; s/^-//; s/-$//' | cut -c1-40 | sed 's/-$//')
    slug=${slug:-ticket}
    branch="$type/GH-$number-$slug"
    worktree="$clone.worktrees/gh-$number-$slug"
  fi
  if [ "$json" = 1 ]; then
    printf '{"repo":'; repo_json_string "$repo"
    printf ',"ticket":%s,"branch":' "$((10#$number))"; repo_json_string "$branch"
    printf ',"worktree":'; repo_json_string "$worktree"
    printf ',"clone":'; repo_json_string "$clone"; printf '}\n'
  else
    printf 'Repo: %s\nTicket: %s\nBranch: %s\n' "$repo" "$target" "$branch"
  fi
  [ "$dry" = 0 ] || return 0
  if [ ! -d "$worktree" ]; then
    git -C "$clone" fetch origin || return 2
    base=$(git -C "$clone" symbolic-ref refs/remotes/origin/HEAD) || base=origin/main
    git -C "$clone" worktree add -b "$branch" "$worktree" "$base" || return 2
  fi
  # The launched agent must keep the resolution cache.
  unset APEXYARD_DISABLE_RESOLUTION_CACHE
  helper=${APEXYARD_START_TICKET:-$root/bin/apexyard-start-ticket}
  cd "$worktree" || return 2
  "$helper" "$target" || return 2
  if [ -n "${APEXYARD_AGENT_CMD:-}" ] || [ "$style" = slash ]; then
    launch_skill "$worktree" start-ticket "$target"
  else
    title="Run the start-ticket workflow for $target"
    if ! command -v "$agent" >/dev/null 2>&1; then
      printf 'Run this in your agent tool, from %s: %s\n' "$worktree" "$title"
      return 0
    fi
    if [ "$style" = opencode ]; then exec "$agent" --prompt "$title"; fi
    exec "$agent" "$title"
  fi
}

usage() {
  cat <<'EOF'
Usage: apexyard <command> [args]

Commands:
  --version, version     Print the framework version.
  init [options]         Create an ops repository. Use init --help for options.
  update [--check]        Show upstream changes and start /update.
  doctor                 Environment checks with optional dependency installs (exit 0/1/2: pass/warn/fail).
  doctor --dependencies  Check tools before init; offer installs with consent.
  doctor --drift         List local edits to framework-owned files (exit 0/1/2: none/drift/error).
  status [-b|--briefing]   Compact "where am I" briefing -- workspace, ticket,
                           branch, role. Defaults to --briefing today (the
                           full /status report runs inside Claude Code).
  use [<dir>]            Save or show the ops repository.
  skills                 List framework skills.
  <skill> [args]         Run a framework skill from the ops root.
  start <ticket>        Resolve a repo and open its ticket worktree.
    --repo <name|owner/name>  Select a registered project.
    --agent <name>      Use claude, codex, cursor-agent, opencode, or pi.
    --dry-run           Print the plan without changes.
    --json              Print repo, ticket, branch, worktree, and clone as JSON.
  ticket owner/repo#N    Alias for start.
  check [--repo <r>] [--json]  Run local advisory gate checks on the branch.
  migrate [opts]         Keep the CLI only, or move this fork to a new repo
                           (init layout). See: apexyard migrate --help.

Start resolution: --repo, then the current git origin, then the registry
clone path. In the ops repo, select a project at the numbered prompt.
With --json or no terminal, the prompt lists projects and exits.
Ticket forms: N, repo#N, owner/repo#N.

Run from any folder after selecting an ops repo with apexyard use <dir>.
EOF
}

cli_path=$(resolve_cli_path) || exit 2
if [ "$APEXYARD_CLI_VERSION" = "__VERSION""__" ]; then
  version_root=$(find_ops_root) || version_root=$(cd "$(dirname "$cli_path")/.." && pwd -P)
  framework_version=""
  if [ -f "$version_root/.claude/framework-version" ]; then
    IFS= read -r framework_version < "$version_root/.claude/framework-version" || true
  fi
  APEXYARD_CLI_VERSION=${framework_version#v}
  APEXYARD_CLI_VERSION=${APEXYARD_CLI_VERSION:-unknown}
fi
export APEXYARD_CLI_VERSION
case "${1:-}" in
  --version|version) printf '%s\n' "$APEXYARD_CLI_VERSION"; exit 0 ;;
esac
# Read the notice helper from the real CLI directory.
# shellcheck source=bin/_lib-telemetry.sh
# shellcheck disable=SC1091
source "$(dirname "$cli_path")/_lib-telemetry.sh"
dry_run=0
for arg in "$@"; do [ "$arg" != --dry-run ] || dry_run=1; done
# A dry run must not write configuration.
[ "$dry_run" = 1 ] || telemetry_notice_once || true

cmd="${1:-}"
shift || true

case "$cmd" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
  init|update)
    cli_path=$(resolve_cli_path) || exit 2
    if [ "$cmd" = update ]; then
      APEXYARD_UPDATE_ROOT=$(resolve_ops_root_any) || {
        [ "$?" -ne 2 ] || exit 2
        echo "apexyard update: not inside an apexyard fork" >&2
        exit 2
      }
      export APEXYARD_UPDATE_ROOT
    fi
    exec "$BASH" "$(dirname "$cli_path")/apexyard-$cmd.sh" "$@"
    ;;
  doctor)
    # Use the fork that contains the current directory.
    # Outside a fork, use the real script directory. A PATH symlink must not hide it.
    ops_root=$(resolve_ops_root_any) || {
      [ "$?" -ne 2 ] || exit 2
      ops_root=""
    }
    if [ -z "$ops_root" ]; then
      cli_path=$(resolve_cli_path) || cli_path="${BASH_SOURCE[0]}"
      ops_root=$(cd "$(dirname "$cli_path")/.." && pwd -P) || ops_root=""
    fi
    if [ "${1:-}" = --drift ]; then
      shift
      if [ ! -f "$ops_root/bin/update-files.sh" ]; then
        echo "apexyard: update helper not found at $ops_root/bin/update-files.sh." >&2
        exit 2
      fi
      exec "$BASH" "$ops_root/bin/update-files.sh" --drift --repo "$ops_root" "$@"
    fi
    helper="$ops_root/.claude/skills/preflight/preflight.sh"
    if [ ! -f "$helper" ]; then
      echo "apexyard: preflight helper not found at $helper. Update the fork: git pull upstream dev (or run /update)." >&2
      exit 2
    fi
    exec "$BASH" "$helper" "$@"
    ;;
  status)
    if ops_root=$(resolve_ops_root_any); then
      :
    else
      [ "$?" -ne 2 ] || exit 2
      echo "apexyard: not inside an apexyard fork (no .apexyard-fork marker, and no onboarding.yaml + apexyard.projects.yaml found above $PWD)" >&2
      exit 1
    fi

    helper="$ops_root/.claude/skills/status/briefing.sh"
    if [ ! -x "$helper" ] && [ ! -f "$helper" ]; then
      echo "apexyard: briefing helper not found at $helper" >&2
      echo "  Update your fork: git pull upstream dev (or run /update)." >&2
      exit 1
    fi

    # Today the only flag is --briefing/-b, which is also the default.
    # We accept it explicitly for forward-compat with `apexyard status
    # --full` etc. Anything unknown gets a helpful error.
    case "${1:-}" in
      ""|-b|--briefing) ;;
      *)
        echo "apexyard status: unknown flag '$1' (try --briefing)" >&2
        exit 2
        ;;
    esac

    case "$PWD/" in
      "$ops_root/"*) ;;
      *) cd "$ops_root" || exit 2 ;;
    esac
    exec bash "$helper"
    ;;
  migrate)
    # Resolve ops root the same way as doctor/status, then source the
    # migrate library next to this script (or under the fork's bin/).
    # Migrate changes a repository, so it never uses the saved ops repo.
    ops_root=$(find_ops_root) || ops_root=""
    if [ -z "$ops_root" ]; then
      cli_path=$(resolve_cli_path) || cli_path="${BASH_SOURCE[0]}"
      ops_root=$(cd "$(dirname "$cli_path")/.." && pwd -P) || ops_root=""
    fi
    if [ -z "$ops_root" ] || [ ! -d "$ops_root" ]; then
      echo "apexyard: not inside an apexyard fork and could not resolve CLI root" >&2
      exit 1
    fi
    migrate_lib="$ops_root/bin/_lib-migrate.sh"
    if [ ! -f "$migrate_lib" ]; then
      echo "apexyard: migrate helper not found at $migrate_lib" >&2
      exit 1
    fi
    OPS_ROOT="$ops_root"
    export OPS_ROOT
    # shellcheck source=/dev/null
    . "$migrate_lib"
    apexyard_migrate "$@"
    exit $?
    ;;
  use)
    if [ "$#" -eq 0 ]; then
      saved_ops_root || echo 'No ops repo saved.'
    else
      [ "$#" -eq 1 ] || { echo 'Usage: apexyard use [<dir>]' >&2; exit 2; }
      ops_root=$(cd "$1" 2>/dev/null && pwd -P) || ops_root=""
      if ! is_ops_root "$ops_root"; then
        printf 'apexyard use: not an ApexYard ops repo: %s\n' "$1" >&2
        exit 2
      fi
      if save_ops_root "$ops_root"; then
        printf 'Saved %s as your ops repo.\n' "$ops_root"
      else
        echo 'apexyard: could not save the ops repo.' >&2
        exit 2
      fi
    fi
    ;;
  skills)
    ops_root=$(skill_root) || exit 2
    while IFS= read -r file; do
      name=${file%/SKILL.md}; name=${name##*/}
      description=$(skill_field "$file" description)
      mark=""
      [ "$(skill_field "$file" disable-model-invocation)" != true ] || mark=' (inside the agent only)'
      printf '  %s  %s%s\n' "$name" "$description" "$mark"
    done < <(find "$ops_root/.claude/skills" -mindepth 2 -maxdepth 2 -name SKILL.md | LC_ALL=C sort)
    ;;
  start|ticket)
    # shellcheck source=bin/_lib-repo-resolve.sh
    source "$(dirname "$cli_path")/_lib-repo-resolve.sh"
    ops_root=$(APEXYARD_RESOLVE_READ_ONLY=1 resolve_ops_root_any skills 2>/dev/null) || {
      echo 'apexyard: no repo found. Use --repo <name|owner/name>.' >&2
      exit 2
    }
    ticket_skill "$ops_root" "$@"
    exit $?
    ;;
  check)
    ops_root=$(APEXYARD_RESOLVE_READ_ONLY=1 resolve_ops_root_any skills 2>/dev/null) || {
      echo 'apexyard: no repo found. Use --repo <name|owner/name>.' >&2
      exit 2
    }
    export APEXYARD_CHECK_OPS_ROOT="$ops_root"
    exec "$BASH" "$(dirname "$cli_path")/apexyard-check.sh" "$@"
    ;;
  *)
    ops_root=$(skill_root) || exit 2
    case "$cmd" in
      ''|*[!a-zA-Z0-9_-]*) file="" ;;
      *) file="$ops_root/.claude/skills/$cmd/SKILL.md" ;;
    esac
    if [ -f "$file" ]; then
      if [ "$(skill_field "$file" disable-model-invocation)" = true ]; then
        echo "apexyard: /$cmd records a human approval. Run it inside your agent." >&2
        exit 2
      fi
      launch_skill "$ops_root" "$cmd" "$@"
      exit $?
    fi
    echo "apexyard: unknown command or skill '$cmd'. Run 'apexyard skills' to list them." >&2
    exit 2
    ;;
esac
