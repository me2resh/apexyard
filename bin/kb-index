#!/usr/bin/env bash
# Generate index.md for handbooks/ and every sub-folder that holds entries.
# Usage: bin/kb-index [--root DIR] [--check]

set -u

SCRIPT_DIR=$(CDPATH='' cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/_lib-kb.sh"

ROOT=""
CHECK=0

while [ $# -gt 0 ]; do
  case "$1" in
    --root)
      ROOT=$2
      shift 2
      ;;
    --root=*)
      ROOT=${1#--root=}
      shift
      ;;
    --check)
      CHECK=1
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Usage: bin/kb-index [--root DIR] [--check]

Write index.md under handbooks/ folders.
--check writes nothing and exits 1 when an index would change.
EOF
      exit 0
      ;;
    -*)
      echo "kb-index: unknown option: $1" >&2
      exit 2
      ;;
    *)
      echo "kb-index: unexpected argument: $1" >&2
      exit 2
      ;;
  esac
done

if [ -z "$ROOT" ]; then
  ROOT=$(git rev-parse --show-toplevel) || exit 1
else
  ROOT=$(cd "$ROOT" && pwd) || exit 1
fi

HB="$ROOT/handbooks"
if [ ! -d "$HB" ]; then
  echo "kb-index: no handbooks/ directory under $ROOT" >&2
  exit 0
fi

# Heading label for a folder relative to handbooks/.
folder_heading() {
  local rel=$1
  if [ -z "$rel" ] || [ "$rel" = "." ]; then
    printf '%s\n' "handbooks"
  else
    printf '%s\n' "$rel"
  fi
}

# Read the index fields of one handbook. Missing fields use the kb-migrate defaults.
# Sets KB_TITLE KB_OWNER KB_VERIFIED_ON KB_STALE_AFTER KB_STATUS.
load_entry() {
  local rel=$1 abspath=$2 body="" vdate
  if kb_has_front_matter "$abspath"; then
    body=$(kb_front_matter_body "$abspath")
  fi
  KB_OWNER=$(kb_fm_scalar "$body" "owner")
  [ -n "$KB_OWNER" ] || KB_OWNER=$(kb_file_author "$ROOT" "$rel")
  vdate=$(kb_file_commit_date "$ROOT" "$rel")
  KB_VERIFIED_ON=$(kb_fm_scalar "$body" "verified_on")
  [ -n "$KB_VERIFIED_ON" ] || KB_VERIFIED_ON=$vdate
  KB_STALE_AFTER=$(kb_fm_scalar "$body" "stale_after")
  [ -n "$KB_STALE_AFTER" ] || KB_STALE_AFTER=$(kb_add_days "$KB_VERIFIED_ON" 180)
  KB_STATUS=$(kb_fm_scalar "$body" "status")
  [ -n "$KB_STATUS" ] || KB_STATUS=active
  KB_TITLE=$(awk '/^# / { sub(/^# /,""); print; exit }' "$abspath")
  if [ -z "$KB_TITLE" ]; then
    KB_TITLE=$(basename "$rel")
    KB_TITLE=${KB_TITLE%.*}
  fi
}

# Build index.md content for one absolute directory under handbooks/.
build_index() {
  local dir=$1
  local rel_from_hb content title owner von stale status link base name
  local entries_tmp subs_tmp

  rel_from_hb=${dir#"$HB"/}
  if [ "$rel_from_hb" = "$dir" ]; then
    rel_from_hb="."
  fi

  entries_tmp=$(mktemp)
  subs_tmp=$(mktemp)

  # Entry files in this folder only.
  if [ -d "$dir" ]; then
    for f in "$dir"/*.md; do
      [ -e "$f" ] || continue
      name=$(basename "$f")
      case "$name" in
        README.md|index.md) continue ;;
      esac
      base=${f#"$ROOT"/}
      load_entry "$base" "$f"
      title=$KB_TITLE
      # Escape pipes in table cells.
      title=$(printf '%s' "$title" | sed 's/|/\\|/g')
      owner=$(printf '%s' "$KB_OWNER" | sed 's/|/\\|/g')
      von=$KB_VERIFIED_ON
      stale=$KB_STALE_AFTER
      status=$KB_STATUS
      link=$name
      # Sort key is the filename.
      printf '%s\t%s\n' "$name" "| $title | $owner | $von | $stale | $status | [$link]($link) |" >> "$entries_tmp"
    done
  fi

  # Immediate sub-folders (any child dir).
  if [ -d "$dir" ]; then
    for sub in "$dir"/*; do
      [ -d "$sub" ] || continue
      name=$(basename "$sub")
      printf '%s\n' "$name" >> "$subs_tmp"
    done
  fi

  content=$(
    printf '%s\n' '<!-- generated by bin/kb-index. Do not edit. -->'
    printf '# Index: %s\n' "$(folder_heading "$rel_from_hb")"
    printf '\n'
    printf '%s\n' '| Title | Owner | Verified on | Stale after | Status | Link |'
    printf '%s\n' '| --- | --- | --- | --- | --- | --- |'
    if [ -s "$entries_tmp" ]; then
      LC_ALL=C sort -t "$(printf '\t')" -k1,1 "$entries_tmp" | cut -f2-
    fi
    printf '\n'
    printf '%s\n' '## Sub-folders'
    printf '\n'
    if [ -s "$subs_tmp" ]; then
      LC_ALL=C sort "$subs_tmp" | while IFS= read -r name; do
        [ -n "$name" ] || continue
        printf -- '- [%s](%s/index.md)\n' "$name" "$name"
      done
    else
      printf '%s\n' '_None._'
    fi
  )

  rm -f "$entries_tmp" "$subs_tmp"
  printf '%s\n' "$content"
}

# Directories that need an index: handbooks itself and every subdir.
dirs_tmp=$(mktemp)
printf '%s\n' "$HB" >> "$dirs_tmp"
find "$HB" -mindepth 1 -type d | LC_ALL=C sort >> "$dirs_tmp"

drift=0
while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  content=$(build_index "$dir")
  target="$dir/index.md"
  if [ "$CHECK" -eq 1 ]; then
    if [ ! -f "$target" ]; then
      echo "kb-index: missing $target" >&2
      drift=1
      continue
    fi
    current=$(cat "$target")
    # Compare with trailing newline normalised.
    if [ "$(printf '%s\n' "$current")" != "$(printf '%s\n' "$content")" ]; then
      echo "kb-index: drift in $target" >&2
      drift=1
    fi
  else
    tmp=$(mktemp)
    printf '%s\n' "$content" > "$tmp"
    mv "$tmp" "$target"
    echo "wrote ${target#"$ROOT"/}"
  fi
done < "$dirs_tmp"
rm -f "$dirs_tmp"

if [ "$CHECK" -eq 1 ] && [ "$drift" -ne 0 ]; then
  exit 1
fi
exit 0
