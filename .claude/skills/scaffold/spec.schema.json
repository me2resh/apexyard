            "source": {
              "enum": [
                "owner",
                "recommendation",
                "onboarding",
                "prd",
                "default",
                "derived"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "if": {
            "properties": {
              "source": {
                "const": "recommendation"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
