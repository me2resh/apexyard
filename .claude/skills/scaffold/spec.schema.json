{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scaffold spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "scale",
    "answers",
    "openQuestions",
    "unusedFields",
    "createdAt"
  ],
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "scale": {
      "enum": [
        "demo",
        "small",
        "production"
      ]
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reuseConfirm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source"
          ],
          "properties": {
            "value": {
              "enum": [
                "Use these",
                "Change one",
                "Ignore them and ask me"
              ]
            },
            "source": {
              "enum": [
                "owner",
                "recommendation",
                "onboarding",
                "prd",
                "default",
                "derived"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "if": {
            "properties": {
              "source": {
                "const": "recommendation"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source"
          ],
