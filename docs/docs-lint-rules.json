{
  "version": 1,
  "about": "Rules for the ASD-STE100 docs lint (docs-site/scripts/lint-docs.mjs). One data file holds every rule. The framework repository hosts a copy at docs/docs-lint-rules.json. When the release cache has that copy, the lint uses it first.",
  "sentenceLength": {
    "step": 20,
    "description": 25,
    "about": "Maximum words in one sentence. 'step' applies to numbered list items (procedure steps). 'description' applies to all other text."
  },
  "passive": {
    "about": "A heuristic: a form of 'be', then up to one adverb, then a past participle. It misses passives without 'be' and can flag an adjective that ends in -ed.",
    "auxiliaries": ["am", "is", "are", "was", "were", "be", "been", "being"],
    "adverbs": ["not", "also", "then", "now", "only", "always", "never", "still", "usually", "often", "automatically", "already"],
    "regularSuffix": "ed",
    "regularMinLength": 4,
    "regularExclude": ["need", "feed", "seed", "speed", "indeed", "embed", "proceed", "exceed", "succeed", "bed", "red", "shed", "led", "wed", "hundred", "kindred"],
    "irregular": ["written", "done", "made", "given", "shown", "known", "taken", "seen", "built", "sent", "kept", "found", "held", "left", "set", "put", "told", "bound", "brought", "caught", "chosen", "drawn", "driven", "hidden", "laid", "lost", "meant", "spent", "split", "spoken", "thrown", "understood", "broken", "begun", "run", "read", "cut", "shut", "hit", "won", "forgotten", "frozen", "gotten", "struck", "withdrawn"]
  },
  "approved": {
    "about": "Words and phrases the lint accepts. A banned or passive match inside one of these phrases is not a finding.",
    "terms": ["fail closed", "fails closed", "built-in", "just-in-time", "set up"]
  },
  "emDash": {
    "about": "STE uses a period, a colon or a comma. The lint flags each em dash outside code.",
    "characters": ["—"],
    "use": "a period, a colon or a comma"
  },
  "banned": {
    "about": "Each entry: kind, term, and the word to use. The match ignores case. A term matches only as a whole word or phrase. The lint ignores code blocks and inline code.",
    "entries": [
      ["idiom", "out of the box", "by default"],
      ["idiom", "under the hood", "inside"],
      ["idiom", "on the fly", "during the run"],
      ["idiom", "in a nutshell", "in short"],
      ["idiom", "at the end of the day", "(delete)"],
      ["idiom", "low-hanging fruit", "easy first task"],
      ["idiom", "heavy lifting", "most of the work"],
      ["idiom", "boils down to", "is"],
      ["idiom", "bells and whistles", "extra features"],
      ["idiom", "rule of thumb", "general rule"],
      ["idiom", "game changer", "large change"],
      ["idiom", "best of both worlds", "(state the two benefits)"],
      ["idiom", "the bottom line", "the result"],
      ["idiom", "from scratch", "from the start"],
      ["idiom", "up and running", "ready"],
      ["idiom", "on the same page", "in agreement"],
      ["idiom", "in the loop", "informed"],
      ["idiom", "keep an eye on", "monitor"],
      ["idiom", "moving parts", "parts"],
      ["idiom", "sweet spot", "best value"],
      ["idiom", "silver bullet", "full solution"],
      ["idiom", "rabbit hole", "(state the problem)"],
      ["idiom", "kick off", "start"],
      ["idiom", "first-class", "full"],
      ["idiom", "spin up", "start"],
      ["idiom", "ballpark", "approximate"],
      ["vague", "simply", "(delete)"],
      ["vague", "just", "only, or (delete)"],
      ["vague", "easily", "(delete)"],
      ["vague", "basically", "(delete)"],
      ["vague", "obviously", "(delete)"],
      ["vague", "clearly", "(delete)"],
      ["vague", "quite", "(delete)"],
      ["vague", "very", "(delete)"],
      ["vague", "really", "(delete)"],
      ["vague", "actually", "(delete)"],
      ["vague", "literally", "(delete)"],
      ["vague", "stuff", "(name the item)"],
      ["vague", "etc.", "(list all items)"],
      ["vague", "and so on", "(list all items)"],
      ["vague", "a lot of", "many, much"],
      ["vague", "lots of", "many, much"],
      ["vague", "various", "(name the items)"],
      ["vague", "somewhat", "(delete)"],
      ["vague", "fairly", "(delete)"],
      ["vague", "seamless", "(delete)"],
      ["vague", "seamlessly", "(delete)"],
      ["vague", "robust", "(state the property)"],
      ["vague", "powerful", "(state the property)"],
      ["contraction", "can't", "cannot"],
      ["contraction", "don't", "do not"],
      ["contraction", "doesn't", "does not"],
      ["contraction", "didn't", "did not"],
      ["contraction", "isn't", "is not"],
      ["contraction", "aren't", "are not"],
      ["contraction", "wasn't", "was not"],
      ["contraction", "weren't", "were not"],
      ["contraction", "won't", "will not"],
      ["contraction", "wouldn't", "would not"],
      ["contraction", "shouldn't", "should not"],
      ["contraction", "couldn't", "could not"],
      ["contraction", "haven't", "have not"],
      ["contraction", "hasn't", "has not"],
      ["contraction", "hadn't", "had not"],
      ["contraction", "mustn't", "must not"],
      ["contraction", "needn't", "need not"],
      ["contraction", "it's", "it is"],
      ["contraction", "that's", "that is"],
      ["contraction", "there's", "there is"],
      ["contraction", "here's", "here is"],
      ["contraction", "what's", "what is"],
      ["contraction", "who's", "who is"],
      ["contraction", "let's", "(use the imperative)"],
      ["contraction", "you're", "you are"],
      ["contraction", "we're", "we are"],
      ["contraction", "they're", "they are"],
      ["contraction", "you've", "you have"],
      ["contraction", "we've", "we have"],
      ["contraction", "they've", "they have"],
      ["contraction", "i've", "I have"],
      ["contraction", "you'll", "you will"],
      ["contraction", "we'll", "we will"],
      ["contraction", "they'll", "they will"],
      ["contraction", "it'll", "it will"],
      ["contraction", "i'm", "I am"],
      ["contraction", "i'd", "I would"],
      ["contraction", "you'd", "you would"],
      ["contraction", "we'd", "we would"],
      ["contraction", "they'd", "they would"]
    ]
  }
}
